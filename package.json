{
  "name": "dsh-skills-manager",
  "version": "2.0.0",
  "description": "Settings → Skills page plus a check_required_skills tool: see every skill your session can invoke, pin the ones your prompts require, and let the agent verify they are loaded.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "skills",
    "agent"
  ]
}
